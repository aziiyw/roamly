# GitHub Pages (default deployment):
# The GLM key now lives in config.js, NOT in an env var. Open config.js and
# paste a throwaway Z.AI key. ⚠️  That key is PUBLIC — anyone can read it in
# the browser — so use a low-quota key you can rotate or delete. See config.js
# for the full warning.
GLM_API_KEY=replace-with-a-throwaway-zai-key

# Vercel fallback (optional):
# If you deploy to Vercel instead, put this same key in Project Settings →
# Environment Variables as GLM_API_KEY. On Vercel it stays secret server-side
# and is used by api/analyze.js.
